# Caminho absoluto do banco de dados. o sync e o subscriber devem coincidir e inserir um caminho absoluto no .env do pi
SQLITE_PATH=/var/lib/rssf/pi.db

# Mosquitto do prórpio pi 
MQTTHOST=localhost
MQTTUSERNAME=
MQTTPASSWORD=
MQTTPORT=1883
CLOUD_URL=http://127.0.0.1:8000
SYNC_INTERVALO = 60
#Só no env local. No deploy, usa backend_rssf
MQTT_CLIENT_ID=pi_rssf #Não usar o mesmo quando fazer deploy

# Preserve o no instalado (transmissao a cada 30 minutos).
STATUS_ONLINE_MINUTES=60
STATUS_OFFLINE_MINUTES=180

# Vazio desabilita lotes. Preencha com o senderAddress REAL do laboratorio.
LAB_SENSOR_ID=
LAB_GATEWAY_ID=gateway_lab_01
LAB_ONLINE_MINUTES=540
LAB_OFFLINE_MINUTES=1440